def selection_sort(dizi):
    for i in range(len(dizi)):
        min_index = i
        for j in range(i+1, len(dizi)):
            if dizi[j] < dizi[min_index]:
                min_index = j
        dizi[i], dizi[min_index] = dizi[min_index], dizi[i]
    return dizi

print(selection_sort([5,3,8,1]))