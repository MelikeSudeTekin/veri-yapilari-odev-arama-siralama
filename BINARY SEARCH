def binary_search(dizi, hedef):
    sol = 0
    sag = len(dizi) - 1

    while sol <= sag:
        orta = (sol + sag) // 2

        if dizi[orta] == hedef:
            return orta
        elif dizi[orta] < hedef:
            sol = orta + 1
        else:
            sag = orta - 1

    return -1

liste = [10, 20, 30, 40, 50]
print(binary_search(liste, 40))